{
  "name": "dsh-capri",
  "version": "0.2.0",
  "description": "摩羯的 DSH 桥：把会话事件和余额（含峰谷）喂给桌面上的她；不再往页面里画人。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "capri",
    "desktop-pet",
    "companion"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}