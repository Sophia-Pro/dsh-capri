{
  "name": "capri-desktop",
  "version": "0.2.0",
  "description": "摩羯 · DeepSeek Harness 的 macOS 桌面挂件（含 DSH 桥插件 dsh-plugin/）",
  "author": "Sophia-Pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sophia-Pro/dsh-capri.git"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "test": "node --test dsh-plugin/test/plugin.test.mjs",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "dist": "echo \"用 ~/Applications/capri-build.sh 打 .app；发布包用 ditto 压缩\""
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    }
  },
  "homepage": "https://github.com/Sophia-Pro/dsh-capri"
}