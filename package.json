{
  "name": "dsh-capri",
  "version": "0.2.0",
  "description": "摩羯住进 DSH 页面里：跟着会话干活表演、点她说话、报额度和阶段；一个插件，全平台，不用装软件。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "capri",
    "desktop-pet",
    "companion"
  ],
  "files": [
    "lib",
    "client",
    "assets",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "使用说明.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}